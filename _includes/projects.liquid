{% if project.redirect %}
  {% assign project_href = project.redirect %}
{% else %}
  {% assign project_href = project.url | relative_url %}
{% endif %}
{% assign project_image = project.logo | default: project.img %}

<article class="project-card project-card--{{ project.category }}{% if project.thumbnail_fit %} project-card--fit-{{ project.thumbnail_fit }}{% endif %}">
  {% if project_image %}
    <a class="project-card__media" href="{{ project_href }}" aria-label="Open {{ project.title }}">
      {%
        include figure.liquid
        loading="lazy"
        path=project_image
        sizes="(min-width: 992px) 280px, (min-width: 576px) 44vw, 92vw"
        alt=project.thumbnail_alt
        class="project-card__image"
      %}
      {% if project.category == 'fun' and project.video %}
        <span class="project-card__play" aria-hidden="true"><i class="ti ti-player-play-filled"></i></span>
      {% endif %}
    </a>
  {% endif %}

  <div class="project-card__body">
    <div class="project-card__heading">
      <h3><a href="{{ project_href }}">{{ project.title }}</a></h3>
      <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
    </div>
    {% unless project.logo_only %}
      <p>{{ project.description }}</p>
      {% if project.github %}
        <a class="project-card__meta" href="{{ project.github }}" aria-label="{{ project.title }} code repository">
          <i class="fa-brands fa-github" aria-hidden="true"></i>
          Code
          {% if project.github_stars %}
            <span class="stars">
              <i class="fa-solid fa-star" aria-hidden="true"></i>
              <span id="{{ project.github_stars }}-stars"></span>
            </span>
          {% endif %}
        </a>
      {% endif %}
    {% endunless %}
  </div>
</article>
